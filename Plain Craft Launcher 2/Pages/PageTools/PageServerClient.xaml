<local:MyPageRight x:Class="PCL.PageServerClient"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL"
                   xmlns:loc="https://ce.pclc.cc/core/localization">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="25,25,25,10">
            <local:MyCard Title="雾光之屿" Margin="0,0,0,15">
                <StackPanel Margin="25,40,25,18">
                    <TextBlock x:Name="LabStatus" FontSize="13.5" TextWrapping="Wrap"
                               Text="正在检测程序文件…" />
                    <local:MyButton x:Name="BtnLaunch" Height="40" Width="180" Margin="0,18,0,0"
                                    HorizontalAlignment="Left" Text="启动"
                                    ColorType="Highlight" Click="BtnLaunch_Click" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>